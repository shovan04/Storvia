{
  "environment": "production",
  "service": {
    "name": "storvia-api",
    "release": "set-at-build"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "read_header_timeout": "10s",
    "read_timeout": "60s",
    "write_timeout": "0s",
    "idle_timeout": "120s",
    "upload_timeout": "30m",
    "shutdown_grace": "30s"
  },
  "logging": {
    "level": "info",
    "format": "json"
  },
  "database": {
    "driver": "postgres",
    "host": "postgres",
    "port": 5432,
    "user": "storvia",
    "database": "storvia",
    "sslmode": "require",
    "max_open_conns": 25,
    "max_idle_conns": 10,
    "conn_max_lifetime": "30m",
    "conn_max_idle_time": "5m",
    "auto_migrate": false
  },
  "cache": {
    "driver": "redis",
    "redis_address": "redis:6379",
    "redis_database": 0,
    "janitor_interval": "1m"
  },
  "auth": {
    "session_cookie_name": "storvia_session",
    "session_ttl": "12h",
    "secure_cookie": true,
    "admin_session_ttl": "720h"
  },
  "admin_panel": {
    "enabled": false,
    "tenant_id": "",
    "user_id": "",
    "flow_cookie": "storvia_admin_flow"
  },
  "security": {
    "allowed_origins": [],
    "allowed_endpoint_schemes": [
      "https"
    ],
    "allowed_endpoint_hosts": [
      "*.r2.cloudflarestorage.com",
      "s3.amazonaws.com",
      "*.amazonaws.com"
    ]
  },
  "uploads": {
    "max_file_size_bytes": 5368709120,
    "allowed_mime_types": [
      "application/pdf",
      "application/zip",
      "text/csv",
      "text/plain",
      "image/jpeg",
      "image/png"
    ],
    "allowed_categories": [
      "report",
      "document",
      "image"
    ],
    "drive_chunk_size_bytes": 8388608,
    "s3_part_size_bytes": 8388608,
    "min_part_size_bytes": 5242880,
    "presigned_url_ttl": "15m",
    "category_limits": {
      "image": 26214400
    }
  },
  "drive": {
    "redirect_uri": "https://api.storvia.example/v1/storage/connections/google-drive/callback",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ],
    "root_folder_name": "Storvia",
    "store_in_app_data_folder": false,
    "preflight_timeout": "3s",
    "preflight_attempts": 2,
    "routing_budget": "8s",
    "circuit_failures": 2,
    "circuit_cooldown": "30s"
  },
  "fallback": {
    "enabled": false,
    "consent_required": false,
    "force": false,
    "backends": [
      {
        "id": "r2-primary",
        "vendor": "cloudflare_r2",
        "region": "auto",
        "bucket": "storvia-fallback",
        "prefix": "prod",
        "use_path_style": true,
        "disabled": true,
        "multipart_abort_ttl": "24h"
      }
    ]
  },
  "worker": {
    "enabled": true,
    "owner": "",
    "lease": "2m",
    "poll": "5s",
    "max_attempts": 5
  }
}
