{
  "name": "@shovan04/storvia-ts",
  "version": "0.1.0",
  "description": "TypeScript client for the Storvia Drive-first file storage API",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shovan04/storvia.git",
    "directory": "sdk/ts"
  },
  "bugs": {
    "url": "https://github.com/shovan04/storvia/issues"
  },
  "homepage": "https://github.com/shovan04/storvia#readme",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}